// Prisma schema for the LISS11' alumni site.
// Core tables only. Enough to prove the migration workflow in Sprint 0.
// The votes table's INSERT-only rule is enforced by a DB trigger in
// votes_immutability.sql (Prisma cannot express triggers/RLS).
//
// Convention: camelCase Prisma/TS fields, snake_case DB columns (via @map).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  EDITOR
  ELECTORAL_COMMITTEE
  ADMIN
  SUPER_ADMIN
}

model Member {
  id           String    @id @default(uuid())
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(MEMBER)
  verified     Boolean   @default(false)
  // Toggle for the PRD section 11 "registration approval" decision.
  // Defaults to true (verify-only). Flip the default to false later to
  // require admin approval before login, without a schema rewrite.
  approved     Boolean   @default(true)
  // Bumped whenever credentials change (e.g. password reset). Embedded in the
  // JWT as `ver`; a mismatch invalidates outstanding sessions.
  tokenVersion Int       @default(0) @map("token_version")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  votes               Vote[]
  payments            Payment[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  eventRsvps          EventRsvp[]

  @@map("members")
}

// Single-use email-verification tokens. Only the SHA-256 hash is stored;
// the raw token lives only in the emailed link.
model VerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String   @map("member_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("verification_tokens")
}

// Single-use password-reset tokens. SHA-256 hash only; short-lived (1h).
model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String   @map("member_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Election {
  id        String     @id @default(uuid())
  title     String
  isOpen    Boolean    @default(false) @map("is_open")
  opensAt   DateTime?  @map("opens_at")
  closesAt  DateTime?  @map("closes_at")
  createdAt DateTime   @default(now()) @map("created_at")

  positions Position[]
  votes     Vote[]

  @@map("elections")
}

model Position {
  id         String      @id @default(uuid())
  title      String
  election   Election    @relation(fields: [electionId], references: [id])
  electionId String      @map("election_id")

  candidates Candidate[]
  votes      Vote[]

  @@map("positions")
}

model Candidate {
  id         String   @id @default(uuid())
  name       String
  manifesto  String?
  position   Position @relation(fields: [positionId], references: [id])
  positionId String   @map("position_id")

  votes Vote[]

  @@map("candidates")
}

// INSERT-only. A DB trigger blocks UPDATE/DELETE (see votes_immutability.sql).
// One vote per member per position is enforced by the unique constraint.
model Vote {
  id          String    @id @default(uuid())
  member      Member    @relation(fields: [memberId], references: [id])
  memberId    String    @map("member_id")
  election    Election  @relation(fields: [electionId], references: [id])
  electionId  String    @map("election_id")
  position    Position  @relation(fields: [positionId], references: [id])
  positionId  String    @map("position_id")
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  candidateId String    @map("candidate_id")
  castAt      DateTime  @default(now()) @map("cast_at")

  @@unique([memberId, positionId])
  @@map("votes")
}

// Contact-form submissions. Stored so nothing is lost if the email
// notification fails; an admin inbox view can read these later.
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

enum PaymentType {
  DUES
  DONATION
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id        String        @id @default(uuid())
  member    Member        @relation(fields: [memberId], references: [id])
  memberId  String        @map("member_id")
  type      PaymentType
  amount    Int // kobo (smallest currency unit), per Paystack convention
  reference String        @unique
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("payments")
}

// --- Sprint 3: EXCOS / BOT / Regions content (PRD 4.3-4.5) ---

enum OfficerTier {
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY
  PRO
  TREASURER
  OTHER
}

// Executive committee officer (PRD 4.3).
model Officer {
  id        String      @id @default(uuid())
  firstName String      @map("first_name")
  lastName  String      @map("last_name")
  title     String // displayed role, e.g. "Financial Secretary"
  tier      OfficerTier @default(OTHER) // for grouping/ordering
  email     String
  whatsapp  String?
  termStart Int?        @map("term_start") // year, e.g. 2024
  termEnd   Int?        @map("term_end") // year, e.g. 2026
  photoUrl  String?     @map("photo_url")
  isPast    Boolean     @default(false) @map("is_past") // past executives section
  sortOrder Int         @default(0) @map("sort_order")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("officers")
}

// Board of Trustees member (PRD 4.4).
model BotMember {
  id          String   @id @default(uuid())
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  designation String
  bio         String?
  email       String?
  photoUrl    String?  @map("photo_url")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("bot_members")
}

enum RegionKey {
  SOUTH_SOUTH
  SOUTH_EAST
  SOUTH_WEST
  NORTH
  DIASPORA
}

// One of the five fixed regions (PRD 4.5). Seeded; edited, not created/deleted.
model Region {
  id          String    @id @default(uuid())
  key         RegionKey @unique
  name        String
  description String?
  repName     String?   @map("rep_name")
  repEmail    String?   @map("rep_email")
  repWhatsapp String?   @map("rep_whatsapp")
  memberCount Int       @default(0) @map("member_count")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("regions")
}

// --- Sprint 4: Announcements + Gallery (PRD 4.6 / "Better Update") ---

// News/update post shown in the announcements feed and the home preview.
model Announcement {
  id          String   @id @default(uuid())
  title       String
  body        String // long-form text (rendered with line breaks)
  coverUrl    String?  @map("cover_url") // optional banner image
  publishedAt DateTime @default(now()) @map("published_at") // the date shown; admin can backdate
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}

// A gallery album groups photos from one event (PRD 4.6). Batch-uploaded.
model Album {
  id          String         @id @default(uuid())
  title       String
  description String?
  coverUrl    String?        @map("cover_url") // falls back to the first image when null
  eventDate   DateTime?      @map("event_date") // when the event happened
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  images      GalleryImage[]

  @@map("albums")
}

// A single photo inside an album. Deleting the album removes its images.
model GalleryImage {
  id        String   @id @default(uuid())
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId   String   @map("album_id")
  url       String
  caption   String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([albumId])
  @@map("gallery_images")
}

// --- Sprint 5: Events + Financial Statements (members-only) ---

// An alumni event (hangout, AGM, game night). Members can RSVP.
model Event {
  id          String      @id @default(uuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime    @map("starts_at")
  endsAt      DateTime?   @map("ends_at")
  coverUrl    String?     @map("cover_url")
  // Public events are visible to everyone (recruitment); members-only events
  // are hidden from logged-out visitors. RSVP always requires login.
  isPublic    Boolean     @default(true) @map("is_public")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  rsvps       EventRsvp[]

  @@index([startsAt])
  @@map("events")
}

// A member's reservation for an event. Row present = attending; one per pair.
model EventRsvp {
  id        String   @id @default(uuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String   @map("event_id")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String   @map("member_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([eventId, memberId])
  @@index([eventId])
  @@map("event_rsvps")
}

// Key-value store for editable site settings (e.g. hero video/poster URLs).
// Small and generic so new settings don't need schema changes.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// A long-form blog article (distinct from short Announcements): public, with
// an SEO-friendly slug, author, excerpt, and draft/publish support.
model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique // SEO-friendly URL segment, generated from title
  title       String
  excerpt     String? // short teaser for the list/preview
  body        String // long-form content (rendered with line breaks)
  coverUrl    String?  @map("cover_url")
  author      String
  isPublished Boolean  @default(true) @map("is_published") // drafts are hidden from the public
  publishedAt DateTime @default(now()) @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([publishedAt])
  @@map("blog_posts")
}

// A financial statement document (PRD: financial transparency). The file is a
// private Cloudinary asset (or local-private in dev); never a public URL. Only
// the storage reference is kept here - members download via a session-gated,
// signed link (see FinancialController + StorageService.getDocumentUrl).
model FinancialStatement {
  id         String   @id @default(uuid())
  title      String
  period     String? // e.g. "2024" or "Q1 2024"
  fileRef    String   @map("file_ref") // storage reference: Cloudinary public_id, or local path
  fileName   String?  @map("file_name") // original filename, for the download
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("financial_statements")
}
