# Postgres connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5544/liss11?schema=public"

# Secret used to sign JWTs — generate a long random value for real environments
JWT_SECRET="change-me-to-a-long-random-string"

# Origin of the web app, used by CORS (must be exact, no wildcard with credentials)
WEB_ORIGIN="http://localhost:5173"

# Public base URL of this API, used to build links inside emails (verify, reset)
API_BASE_URL="http://localhost:4000"

# Email delivery. Provider is chosen at boot (see inversify.config.ts):
#   1. SMTP_* set      -> SMTP (e.g. Gmail)   [preferred]
#   2. RESEND_API_KEY  -> Resend
#   3. neither         -> log links to console (fine for local dev)

# --- Option A: SMTP (e.g. Gmail) ---
# Gmail SMTP is the only way to legitimately send FROM a @gmail.com address.
# SMTP_PASS is a Google App Password (needs 2-Step Verification), not the login
# password. Leave these blank to fall back to Resend/console.
SMTP_HOST=""            # e.g. smtp.gmail.com
SMTP_PORT="465"         # 465 = implicit TLS, 587 = STARTTLS
SMTP_USER=""            # e.g. lissclass11@gmail.com
SMTP_PASS=""            # Google App Password

# --- Option B: Resend ---
# Requires a verified sending domain; onboarding@resend.dev only mails the
# Resend account's own address.
RESEND_API_KEY=""

# Sender shown on outgoing mail. For Gmail SMTP this must be the SMTP_USER
# address (or one of its aliases), e.g. "LISS11' Alumni <lissclass11@gmail.com>".
EMAIL_FROM="LISS11' Alumni <onboarding@resend.dev>"

# Recipient for contact-form notifications. Leave blank to only store
# submissions in the DB (no email sent).
CONTACT_TO=""

# Media uploads (Cloudinary). Find this in your Cloudinary dashboard under
# "API Environment variable". Leave blank to store uploads on local disk.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""

# Error monitoring (Sentry). Leave SENTRY_DSN blank to disable (no account
# needed for local dev). Get the DSN from your Sentry project settings.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="0"

# Port the API listens on
PORT=4000
