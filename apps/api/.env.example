# Postgres connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5544/liss11?schema=public"

# Secret used to sign JWTs — generate a long random value for real environments
JWT_SECRET="change-me-to-a-long-random-string"

# Origin of the web app, used by CORS (must be exact, no wildcard with credentials)
WEB_ORIGIN="http://localhost:5173"

# Public base URL of this API, used to build links inside emails (verify, reset)
API_BASE_URL="http://localhost:4000"

# Email delivery (Resend). Leave RESEND_API_KEY blank to log links to the
# console instead of sending real email (fine for local dev).
RESEND_API_KEY=""
# Temporary development sender. Resend can only use onboarding@resend.dev for
# test emails to the Resend account's own email address. Replace this with a
# verified-domain sender before sending to real users, e.g.
# "LISS11' Alumni <no-reply@liss11alumni.org>".
EMAIL_FROM="LISS11' Alumni <onboarding@resend.dev>"

# Port the API listens on
PORT=4000
