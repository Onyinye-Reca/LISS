# Server
PORT=4000
NODE_ENV=production

# Exact staging web origin allowed by CORS.
WEB_ORIGIN=https://staging-liss11.netlify.app

# Staging PostgreSQL connection string. Do not use the production database here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/liss11_staging?schema=public

# Generate a separate staging secret. Do not reuse production secrets.
JWT_SECRET=replace-with-a-long-random-staging-secret

# Staging is HTTPS on hosted platforms, so cookies should be secure.
COOKIE_SECURE=true

# Optional.
SENTRY_DSN=
